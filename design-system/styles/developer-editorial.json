{
  "schemaVersion": "1.0",
  "id": "developer-editorial",
  "name": "Developer Editorial",
  "version": "0.1.0",
  "status": "draft",
  "theme": "dark",
  "density": "comfortable",
  "accent": "mint",
  "radius": "medium",
  "tokens": {
    "color.canvas": "{color.slate.950}",
    "color.surface": "{color.slate.900}",
    "color.elevated": "{color.slate.800}",
    "color.text": "{color.slate.100}",
    "color.muted": "{color.slate.400}",
    "color.border": "{color.slate.700}",
    "color.controlBorder": "{color.slate.400}",
    "color.accent": "{color.mint.400}",
    "color.accentHover": "{color.mint.300}",
    "color.onAccent": "{color.slate.950}",
    "color.accentSubtle": "{color.slate.800}",
    "color.focus": "{color.mint.300}",
    "color.success": "{color.mint.300}",
    "color.successBackground": "{color.slate.800}",
    "color.warning": "{color.amber.200}",
    "color.warningBackground": "{color.slate.800}",
    "color.error": "{color.red.300}",
    "color.errorBackground": "{color.slate.800}",
